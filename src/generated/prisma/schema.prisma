generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PizzaStore {
  storeid   Int     @id @default(autoincrement())
  storeuuid String  @unique @default(uuid())
  name      String
  location  String
  phone     Int
  email     String
  pizzas    Pizza[]
}

model Pizza {
  pizzaid     Int               @id @default(autoincrement())
  pizzauuid   String            @unique @default(uuid())
  name        String
  description String
  price       Float
  ingredients PizzaIngredient[]
  ratings     PizzaRating[]
  storeId     Int
  store       PizzaStore        @relation(fields: [storeId], references: [storeid])
  orders      Order[]           @relation("OrderPizzas") // Added opposite relation
}

model Desert {
  desertid    Int                 @id @default(autoincrement())
  desertuuid  String              @unique @default(uuid())
  name        String
  price       Float
  ingredients DesertIngredients[]
  orders      Order[]             @relation("OrderDeserts") // Added opposite relation
}

model DesertIngredients {
  desertingredientid   Int      @id @default(autoincrement())
  desertingredientuuid String   @unique @default(uuid())
  name                 String
  deserts              Desert[]
}

model PizzaIngredient {
  ingredientid   Int     @id @default(autoincrement())
  ingredientuuid String  @unique @default(uuid())
  name           String
  pizzas         Pizza[]
}

model Refreshment {
  refreshmentid   Int     @id @default(autoincrement())
  refreshmentuuid String  @unique @default(uuid())
  name            String
  price           Float
  size            String // Example: Small, Medium, Large
  orders          Order[] @relation("OrderRefreshments") // Added opposite relation
}

model PizzaRating {
  ratingid   Int     @id @default(autoincrement())
  ratinguuid String  @unique @default(uuid())
  score      Int     @default(0) // Example: 1-5 scale
  comment    String?
  pizzaId    Int
  pizza      Pizza   @relation(fields: [pizzaId], references: [pizzaid])
}

model Order {
  orderid           Int           @id @default(autoincrement())
  orderuuid         String        @unique @default(uuid())
  date              DateTime      @default(now())
  pizzas            Pizza[]       @relation("OrderPizzas")
  deserts           Desert[]      @relation("OrderDeserts")
  refreshments      Refreshment[] @relation("OrderRefreshments")
  statusId          Int
  status            OrderStatus   @relation(fields: [statusId], references: [statusid])
  orderinstructions String
}

model OrderStatus {
  statusid Int     @id @default(autoincrement())
  name     String  @unique
  orders   Order[]
}
